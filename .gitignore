# Image assets — exclude only RAW original files (too large)
assets/images/original/*

# Keep folder structure & optimized images
!assets/images/original/.gitkeep

# Desktop & mobile optimized images ARE tracked (small WebP files)
# assets/images/desktop/ — TRACKED
# assets/images/mobile/ — TRACKED

# Logo tracked
# assets/images/logo/ — TRACKED

# Node modules (if any)
node_modules/

# System files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Temporary
*.tmp
*.bak
*~
