# Image assets (large files)
assets/images/original/*
assets/images/desktop/*
assets/images/mobile/*

# Keep folder structure
!assets/images/original/.gitkeep
!assets/images/desktop/.gitkeep
!assets/images/mobile/.gitkeep

# Logo should be tracked (small file)
!assets/images/logo/*.png

# Node modules (if any)
node_modules/

# System files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Temporary
*.tmp
*.bak
*~
